# Supabase API Gateway / Endpoint
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000

# Client-side publishable key & legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only keys (for server actions and atomic RPC transactions)
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Cryptographic pepper for hashing single-use voting codes (64-character hex string)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOTING_TOKEN_PEPPER=
